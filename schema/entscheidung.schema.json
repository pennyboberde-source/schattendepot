{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pennyboberde-source.github.io/schattendepot/schema/entscheidung.schema.json",
  "title": "Entscheidung eines Claude-Laufs (laeufe/<datum>-<typ>.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "typ",
    "datum",
    "erstellt"
  ],
  "properties": {
    "typ": {
      "enum": [
        "morgenlauf",
        "mittagslauf",
        "abendlauf",
        "ereignislauf",
        "wochenrueckblick"
      ]
    },
    "datum": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "erstellt": {
      "type": "string",
      "format": "date-time"
    },
    "briefing": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 140
      }
    },
    "orders": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "$ref": "#/definitions/orderPlan"
      }
    },
    "anpassungen": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "orderId",
          "feld",
          "neu",
          "begruendung"
        ],
        "properties": {
          "orderId": {
            "type": "string"
          },
          "feld": {
            "enum": [
              "ziel",
              "stop",
              "verkaufstermin"
            ]
          },
          "neu": {
            "type": [
              "number",
              "string"
            ]
          },
          "begruendung": {
            "type": "string",
            "minLength": 5,
            "maxLength": 200
          }
        }
      }
    },
    "berichte": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "orderId",
          "text",
          "learnings"
        ],
        "properties": {
          "orderId": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 50,
            "maxLength": 4000
          },
          "learnings": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "string",
              "maxLength": 300
            }
          },
          "einwandEingetreten": {
            "type": "boolean",
            "description": "Ist der Einwand der Gegenprüfung eingetreten? (nur bei Orders mit gegenpruefung)"
          },
          "ersetzt": {
            "type": "boolean",
            "description": "true = ersetzt einen alten Bericht mit veralteten Gebührenzahlen (nur für Orders, die der Kontext dafür nennt)"
          }
        }
      }
    },
    "lektionen": {
      "type": "string",
      "maxLength": 20000,
      "description": "Vollständiger neuer Inhalt von lernen/lektionen.md (nur Abendlauf)"
    },
    "gewichtsvorschlaege": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "art",
          "name",
          "faktor",
          "begruendung"
        ],
        "properties": {
          "art": {
            "enum": [
              "signal",
              "quelle"
            ]
          },
          "name": {
            "type": "string"
          },
          "faktor": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 1.5
          },
          "begruendung": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "wochenrueckblick": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "push",
        "text"
      ],
      "properties": {
        "push": {
          "type": "string",
          "maxLength": 180
        },
        "text": {
          "type": "string",
          "maxLength": 8000
        }
      }
    },
    "notiz": {
      "type": "string",
      "maxLength": 2000
    },
    "prognose": {
      "type": "array",
      "maxItems": 10,
      "description": "Claudes Tagesprognose (nur Morgenlauf): Richtung je Wert, ohne Geld, wird gemessen",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "ticker",
          "markt",
          "richtung"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "ticker": {
            "type": "string",
            "pattern": "^[A-Za-z0-9.-]{1,15}$"
          },
          "markt": {
            "enum": [
              "us",
              "eu",
              "krypto"
            ]
          },
          "richtung": {
            "enum": [
              "hoch",
              "runter"
            ]
          },
          "chance": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "grund": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "daytrading": {
      "type": "array",
      "maxItems": 5,
      "description": "Daytrading-Watchlist (nur Morgenlauf): der Code handelt die Werte nach der Skill-Regel (Eröffnungsspanne oder Level) im eigenen Bereich Daytrading",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "markt",
          "setup",
          "richtung",
          "chance",
          "these"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "markt": {
            "enum": [
              "us",
              "eu",
              "krypto"
            ]
          },
          "isin": {
            "type": "string",
            "pattern": "^[A-Z]{2}[A-Z0-9]{9}[0-9]$",
            "description": "Pflicht bei us/eu (gettex-Kurse nach ISIN)"
          },
          "symbol": {
            "type": "string",
            "pattern": "^[A-Z0-9]{2,10}$",
            "description": "Pflicht bei krypto (Kraken-Kürzel, z. B. BTC)"
          },
          "setup": {
            "enum": [
              "orb",
              "level"
            ]
          },
          "level": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "nur bei setup level: Kurs in EURO (gettex/Kraken), dessen Überschreiten (long) bzw. Unterschreiten (short) per Schlusskurs einer 5-Minuten-Kerze auslöst"
          },
          "richtung": {
            "enum": [
              "long",
              "short",
              "beide"
            ]
          },
          "instrument": {
            "enum": [
              "aktie",
              "turbo"
            ]
          },
          "hebel": {
            "type": "integer",
            "minimum": 2,
            "maximum": 100
          },
          "chance": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "these": {
            "type": "string",
            "minLength": 10,
            "maxLength": 300
          }
        }
      }
    },
    "heuteGelernt": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "description": "Abendlauf: was heute gelernt wurde (Push „Heute gelernt“ und Seite Heute)",
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 140
      }
    },
    "monatspruefung": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "vorschlaege"
      ],
      "description": "Wochenrückblick am ersten Samstag des Monats: Tiefenprüfung aller Daten",
      "properties": {
        "push": {
          "type": "string",
          "maxLength": 180
        },
        "text": {
          "type": "string",
          "minLength": 100,
          "maxLength": 8000
        },
        "vorschlaege": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "bereich",
              "vorschlag",
              "begruendung"
            ],
            "properties": {
              "bereich": {
                "enum": [
                  "depot",
                  "daytrading",
                  "autopilot",
                  "quellen",
                  "signale",
                  "risiko",
                  "routinen",
                  "sonstiges"
                ]
              },
              "vorschlag": {
                "type": "string",
                "minLength": 5,
                "maxLength": 300
              },
              "begruendung": {
                "type": "string",
                "minLength": 5,
                "maxLength": 400
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "kursbasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "markt",
        "symbol",
        "waehrung"
      ],
      "properties": {
        "markt": {
          "enum": [
            "us",
            "eu",
            "krypto"
          ]
        },
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "waehrung": {
          "enum": [
            "EUR",
            "USD"
          ]
        }
      }
    },
    "orderPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wertpapier",
        "strategie",
        "these",
        "ausloeser",
        "signalIds",
        "quellen",
        "konfidenz",
        "pflichtOrder",
        "erwarteteRenditeNetto",
        "zielNettoProzent",
        "stopProzent",
        "verkaufstermin",
        "risiken",
        "einflussLektionen"
      ],
      "properties": {
        "wertpapier": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "isin",
            "anlageklasse",
            "spreadKlasse",
            "handelsplatz",
            "steuertopf"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 2,
              "maxLength": 80
            },
            "isin": {
              "type": "string",
              "pattern": "^([A-Z]{2}[A-Z0-9]{9}[0-9])?$",
              "description": "ISIN; leer (\"\") nur bei Krypto direkt (anlageklasse \"krypto\")"
            },
            "wkn": {
              "type": "string",
              "pattern": "^[A-Z0-9]{6}$"
            },
            "ticker": {
              "type": "string",
              "maxLength": 15
            },
            "anlageklasse": {
              "enum": [
                "aktie",
                "etf",
                "etc",
                "hebel",
                "krypto_etn",
                "krypto"
              ]
            },
            "spreadKlasse": {
              "enum": [
                "aktie_dax",
                "aktie_large",
                "aktie_neben",
                "etf",
                "hebel",
                "krypto_etn",
                "krypto",
                "spekulativ"
              ]
            },
            "handelsplatz": {
              "enum": [
                "TGT",
                "GTX",
                "LSX",
                "XETRA",
                "FRA",
                "STU",
                "TRK"
              ]
            },
            "steuertopf": {
              "enum": [
                "aktien",
                "sonstige"
              ]
            },
            "teilfreistellung": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.3
            },
            "kursbasis": {
              "$ref": "#/definitions/kursbasis"
            }
          }
        },
        "hebel": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "typ",
            "richtung",
            "emittent",
            "basiswert",
            "basispreis",
            "koSchwelle",
            "bezugsverhaeltnis"
          ],
          "properties": {
            "typ": {
              "enum": [
                "knockout",
                "turbo"
              ]
            },
            "richtung": {
              "enum": [
                "long",
                "short"
              ]
            },
            "emittent": {
              "type": "string"
            },
            "basiswert": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "kursbasis"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "isin": {
                  "type": "string"
                },
                "kursbasis": {
                  "$ref": "#/definitions/kursbasis"
                }
              }
            },
            "basispreis": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "koSchwelle": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "bezugsverhaeltnis": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10
            }
          }
        },
        "etn": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "basiswert",
            "anteilProStueck",
            "kostenProzentJahr"
          ],
          "properties": {
            "basiswert": {
              "$ref": "#/definitions/kursbasis"
            },
            "anteilProStueck": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "kostenProzentJahr": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            }
          }
        },
        "strategie": {
          "enum": [
            "quartalszahlen_momentum",
            "insider_kauf",
            "analysten_hochstufung",
            "ueberreaktion_rebound",
            "sektor_rotation",
            "makro_termin",
            "chart_ausbruch",
            "stimmungswelle",
            "uebernahme",
            "nachzahlen_drift",
            "spekulation",
            "sonstige"
          ]
        },
        "these": {
          "type": "string",
          "minLength": 20,
          "maxLength": 800
        },
        "ausloeser": {
          "type": "string",
          "minLength": 5,
          "maxLength": 300
        },
        "signalIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 20
        },
        "quellen": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "link"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "link": {
                "type": "string",
                "pattern": "^https?://"
              }
            }
          }
        },
        "konfidenz": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "pflichtOrder": {
          "type": "boolean"
        },
        "erwarteteRenditeNetto": {
          "type": "number",
          "minimum": -50,
          "maximum": 200
        },
        "zielNettoProzent": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 200
        },
        "stopProzent": {
          "type": "number",
          "minimum": -90,
          "exclusiveMaximum": 0
        },
        "verkaufstermin": {
          "type": "string",
          "format": "date-time"
        },
        "risiken": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "einflussLektionen": {
          "type": "string",
          "maxLength": 500
        },
        "risikoklasse": {
          "enum": [
            "normal",
            "spekulativ"
          ]
        },
        "gegenpruefung": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "einwand",
            "risiko"
          ],
          "description": "Gegenprüfung vor dem Kauf: woran könnte es scheitern, und wie wahrscheinlich (in %)?",
          "properties": {
            "einwand": {
              "type": "string",
              "minLength": 10,
              "maxLength": 300
            },
            "risiko": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "hebelWunsch": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "richtung",
            "hebel"
          ],
          "description": "Statt der Aktie/des ETFs einen Turbo mit diesem Hebel kaufen; der Code bildet ihn beim Kauf nach (Basispreis = KO aus dem Kurs). Ziel/Stop beziehen sich dann auf den Turbo.",
          "properties": {
            "richtung": {
              "enum": [
                "long",
                "short"
              ]
            },
            "hebel": {
              "type": "integer",
              "minimum": 2,
              "maximum": 100
            }
          }
        }
      }
    }
  }
}
